# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mood-studios

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (required for cookie sessions — must match the browser origin exactly)
# Mobile app (Flutter): CLIENT_URL
# Admin dashboard: ADMIN_URL
# Landing site: LANDING_URL — also used so /api/auth login sets httpOnly cookies
CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:3000
LANDING_URL=http://localhost:5173

# Cookie auth: NODE_ENV=development → SameSite=Lax, Secure=false (localhost OK)
# Production → SameSite=None + Secure=true (HTTPS required on landing + API)

# Admin registration (set true only during initial setup)
ALLOW_ADMIN_REGISTER=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayMongo (use sk_test_ / pk_test_ keys for testing)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Allow POST /payments/:id/confirm with { "testConfirm": true } when using test keys
ALLOW_TEST_PAYMENT_CONFIRM=true

# SendGrid (Twilio) — email OTP verification
# Create API key at https://app.sendgrid.com/ and verify sender in Settings → Sender Authentication
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Mood Studios

# Google reCAPTCHA v2 checkbox — https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
# Dev only: skip reCAPTCHA when RECAPTCHA_SECRET_KEY is unset
ALLOW_RECAPTCHA_SKIP=true

# Firebase Cloud Messaging (HTTP v1 — Legacy API must stay disabled in Console)
FIREBASE_PROJECT_ID=mood-studios-3172f
# Local: path to JSON from Firebase Console → Project settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Render/production: paste full JSON on one line (do not commit)
# FIREBASE_SERVICE_ACCOUNT_JSON=
